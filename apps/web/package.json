{
  "name": "@beacon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_USE_MOCKS=true vite --host 0.0.0.0",
    "dev:api": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/generated/schema.d.ts",
    "lint": "eslint . && prettier --check .",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "app JS (all dist/assets/*.js, gzip)",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "150 kB"
    }
  ],
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.2",
    "@size-limit/file": "12.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "size-limit": "12.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "6.4.4",
    "vitest": "3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
