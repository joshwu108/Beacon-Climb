{
  "name": "@beacon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check .",
    "fmt": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "250 kB"
    }
  ],
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.2",
    "@size-limit/preset-small-lib": "12.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "prettier": "3.8.1",
    "size-limit": "12.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "6.4.4",
    "vitest": "3.2.4"
  }
}
