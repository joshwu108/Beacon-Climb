{
  "name": "@beacon/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "EXPO_PUBLIC_USE_MOCKS=true expo start --web --port 8081",
    "web:api": "EXPO_PUBLIC_USE_MOCKS=false expo start --web --port 8081",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web --output-dir dist",
    "serve:web": "expo serve --port 8090",
    "generate:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && prettier --check .",
    "fmt": "prettier --write .",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-next": "0.4.1",
    "@expo-google-fonts/young-serif": "0.4.0",
    "@expo/metro-runtime": "58.0.13",
    "@tanstack/react-query": "5.104.1",
    "expo": "58.0.6",
    "expo-constants": "58.0.10",
    "expo-crypto": "58.0.5",
    "expo-font": "58.0.7",
    "expo-linking": "58.0.11",
    "expo-router": "58.0.16",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "expo-system-ui": "58.0.5",
    "msw": "2.15.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@react-native/jest-preset": "0.88.0-rc.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.8",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "test-renderer": "1.3.0",
    "typescript": "5.9.3"
  }
}
