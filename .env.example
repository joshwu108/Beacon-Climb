# Copy to .env (gitignored) and set a distinct random value for each entry, e.g.
#   openssl rand -hex 24
# `make dev` refuses to start while any value is missing or empty; there are no
# fallback passwords anywhere in compose or application.yaml (TM-27).
POSTGRES_PASSWORD=
BEACON_MIGRATE_DB_PASSWORD=
BEACON_APP_DB_PASSWORD=
