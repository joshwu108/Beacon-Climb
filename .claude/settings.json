{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git rm --cached *)",
      "Bash(git commit -F *)",
      "Bash(git commit -m *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git config user.*)",
      "Bash(make *)",
      "Bash(./gradlew *)",
      "Bash(gradle *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker info*)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(sha256sum *)",
      "Bash(shasum *)",
      "Bash(sqlite3 *)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)",
      "Bash(stat *)",
      "Bash(date*)",
      "Bash(sleep *)",
      "Bash(bash scripts/*)",
      "Bash(bash test/*)",
      "Bash(bash .claude/hooks/*)"
    ],
    "deny": [
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(git merge*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout --*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git clean*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref*)",
      "Bash(git branch -D*)",
      "Bash(git worktree remove*)",
      "Bash(rm -rf *)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)"
    ]
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-commit-check.sh"
          }
        ]
      }
    ]
  }
}
