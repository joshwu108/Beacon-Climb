{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beacon-climb.local/contracts/decisions/decision-record.v1.schema.json",
  "title": "Decision record and candidate snapshot v1",
  "description": "A document is exactly one of: a candidate snapshot, a full decision record (erased=false), or an erased stub (erased=true, C-03 / TM-29). The stub is what remains after hard erasure (ADR-0003): no user_id, session_id, rng_seed, request_constraints, ranked_results, candidate_snapshot_uri or candidate_set_digest.",
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reasonCode": {
      "type": "string",
      "description": "Same closed list as OpenAPI components.schemas.ReasonCode (planning/06 §9).",
      "enum": [
        "COMPATIBLE_ANGLE",
        "GOAL_CHALLENGE_MATCH",
        "NOVEL_ROUTE",
        "PREFERRED_STYLE",
        "WELL_OBSERVED_GRADE",
        "COOLDOWN_SKIPPED",
        "LOW_INVENTORY_WIDENED",
        "COLD_START_HEURISTIC"
      ]
    },
    "userFeatures": {
      "type": "object",
      "description": "Frozen climber-features aggregate (planning/06 §8, climber-features.v1) plus the policy-derived target grade. All keys optional in v1; unknown keys are rejected.",
      "additionalProperties": false,
      "properties": {
        "attempts_7d": { "type": "integer", "minimum": 0 },
        "attempts_30d": { "type": "integer", "minimum": 0 },
        "attempts_90d": { "type": "integer", "minimum": 0 },
        "sends_7d": { "type": "integer", "minimum": 0 },
        "sends_30d": { "type": "integer", "minimum": 0 },
        "sends_90d": { "type": "integer", "minimum": 0 },
        "send_rate_by_grade_band_90d": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["attempts", "sends"],
            "properties": {
              "attempts": { "type": "integer", "minimum": 0 },
              "sends": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "recent_variant_ids": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" }
        },
        "last_session_at": { "type": ["string", "null"], "format": "date-time" },
        "max_sent_grade_numeric_90d": { "type": ["number", "null"] },
        "distinct_sessions_30d": { "type": "integer", "minimum": 0 },
        "target_grade_numeric": {
          "type": "number",
          "description": "target_grade(goal, grade band) as resolved by the ranking policy at decision time (planning/06 §9); frozen here so the reference ranker is pure."
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_variant_id",
        "eligible",
        "filter_results",
        "features",
        "model_outputs"
      ],
      "properties": {
        "route_variant_id": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        },
        "filter_results": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "features": {
          "type": "object",
          "required": [
            "grade_numeric",
            "hold_count",
            "novelty",
            "cooldown_active",
            "preference_match",
            "grade_observation_count"
          ],
          "properties": {
            "grade_numeric": {
              "type": "number"
            },
            "hold_count": {
              "type": "integer",
              "minimum": 1
            },
            "novelty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cooldown_active": {
              "type": "boolean"
            },
            "preference_match": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grade_observation_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "model_outputs": {
          "type": "object",
          "required": [
            "predicted_grade",
            "embedding_distance",
            "predicted_send_probability"
          ],
          "properties": {
            "predicted_grade": {
              "type": [
                "number",
                "null"
              ]
            },
            "embedding_distance": {
              "type": [
                "number",
                "null"
              ]
            },
            "predicted_send_probability": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "grade_used": {
              "description": "v1.1, optional (BC-0210): the grade the policy scored challenge fit with. For heuristic-v2 it is (grade_observation_count * grade_numeric + blend_k * predicted_grade) / (grade_observation_count + blend_k), or grade_numeric when predicted_grade is null. Absent for heuristic-v1, which scores grade_numeric.",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "CandidateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "user_id",
        "feature_as_of",
        "feature_schema_version",
        "catalog_version",
        "user_features",
        "candidates"
      ],
      "properties": {
        "artifact_type": {
          "const": "candidate_snapshot"
        },
        "schema_version": {
          "const": 1
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "feature_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "feature_schema_version": {
          "type": "string"
        },
        "catalog_version": {
          "type": "string"
        },
        "user_features": {
          "$ref": "#/$defs/userFeatures"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "FullRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "decision_id",
        "user_id",
        "requested_at",
        "session_id",
        "request_constraints",
        "policy_version",
        "policy_config",
        "policy_code_digest",
        "model_version",
        "model_artifact_digest",
        "feature_snapshot_id",
        "feature_as_of",
        "feature_schema_version",
        "candidate_set_digest",
        "rng_seed",
        "experiment_id",
        "assignment_variant",
        "served_variant",
        "ranked_results",
        "environment_digest",
        "catalog_version",
        "erased",
        "candidate_snapshot_uri",
        "explanation"
      ],
      "properties": {
        "artifact_type": {
          "const": "decision_record"
        },
        "schema_version": {
          "const": 1
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_constraints": {
          "type": "object",
          "required": [
            "board_id",
            "angle_deg",
            "goal",
            "max_routes",
            "exclude_route_variant_ids"
          ],
          "properties": {
            "board_id": {
              "type": "string"
            },
            "angle_deg": {
              "type": "integer"
            },
            "goal": {
              "type": "string"
            },
            "max_routes": {
              "type": "integer",
              "minimum": 1
            },
            "exclude_route_variant_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "policy_version": {
          "type": "string"
        },
        "policy_config": {
          "type": "object"
        },
        "policy_code_digest": {
          "$ref": "#/$defs/hex64"
        },
        "model_version": {
          "type": "string"
        },
        "model_artifact_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/hex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_artifacts": {
          "description": "v1.1, optional (BC-0210): every registered model whose precomputed outputs this decision read, by role. model_version / model_artifact_digest above name the grade model (or 'none' / null). A replay needs only the snapshot's frozen model_outputs; these identify where they came from.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "model_version", "artifact_digest"],
            "properties": {
              "role": { "enum": ["grade", "embedding"] },
              "model_version": { "type": "string" },
              "artifact_digest": { "$ref": "#/$defs/hex64" }
            }
          }
        },
        "feature_snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "feature_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "feature_schema_version": {
          "type": "string"
        },
        "candidate_set_digest": {
          "$ref": "#/$defs/hex64"
        },
        "rng_seed": {
          "$ref": "#/$defs/hex64"
        },
        "experiment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignment_variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "served_variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "ranked_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "route_variant_id",
              "position",
              "score",
              "reason_codes"
            ],
            "properties": {
              "route_variant_id": {
                "type": "string"
              },
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "score": {
                "type": "number"
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reasonCode"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "environment_digest": {
          "$ref": "#/$defs/hex64"
        },
        "catalog_version": {
          "type": "string"
        },
        "erased": {
          "const": false
        },
        "candidate_snapshot_uri": {
          "type": "string",
          "pattern": "^data/decisions/[0-9a-f]{2}/[0-9a-f]{64}\\.json$"
        },
        "explanation": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ErasedStub": {
      "type": "object",
      "description": "Post-erasure audit stub (ADR-0003 'Erasure and retention'). Replay of this decision returns REPLAY_UNAVAILABLE_ERASED.",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "decision_id",
        "requested_at",
        "policy_version",
        "model_version",
        "experiment_id",
        "served_variant",
        "erased"
      ],
      "properties": {
        "artifact_type": {
          "const": "decision_record"
        },
        "schema_version": {
          "const": 1
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time",
          "description": "Coarsened: truncated to the day (time component 00:00:00Z) so the stub carries no fine-grained activity timestamp."
        },
        "policy_version": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "experiment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "served_variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "erased": {
          "const": true
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CandidateSnapshot"
    },
    {
      "$ref": "#/$defs/FullRecord"
    },
    {
      "$ref": "#/$defs/ErasedStub"
    }
  ]
}
